NODE_ENV=development
PORT=5000

# MongoDB — set MONGODB_URI, or the parts below
# MONGODB_URI=mongodb+srv://user:pass@cluster/db
MONGODB_USER=your_username
MONGODB_PASSWORD=your_password
MONGODB_CLUSTER=your_cluster    #mongodb+srv://your_username:your_password@your_cluster/your_database
MONGODB_DB=your_database

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
JWT_REMEMBER_EXPIRES_IN=90d

# Shared with QuantumAI backend (≥32 chars) for /messages/quantum-ai-response receipts
QUANTUM_AI_SERVICE_SECRET=your_quantum_ai_service_secret

CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Blob storage
# ---------------------------------------------------------------------------
# Local development: if none of the below are set, files are stored under
# backend/uploads/. Or force local disk with STORAGE_PROVIDER=local
#
# Production / Vercel, option A — personal Google account (no Workspace needed):
# OAuth2 delegated to your own Google account. Uploads count against that
# account's normal 15GB quota. GOOGLE_DRIVE_FOLDER_ID is a plain folder in
# your own My Drive (no sharing required). Get the refresh token by running
# `node scripts/get-drive-oauth-token.mjs` — see that file for setup steps.
# GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id
# GOOGLE_OAUTH_CLIENT_ID=your_oauth_client_id
# GOOGLE_OAUTH_CLIENT_SECRET=your_oauth_client_secret
# GOOGLE_OAUTH_REFRESH_TOKEN=your_oauth_refresh_token
#
# Production / Vercel, option B — Google Workspace: service account + Shared
# Drive folder (share the folder with the service account as Content manager).
# Service accounts have no quota on regular My Drive, so the folder MUST be
# inside a Shared Drive. PRIVATE_KEY: keep \n escapes.
# GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your_google_service_account_email
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#
# STORAGE_PROVIDER=local
