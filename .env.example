NODE_ENV=development
PORT=5000

# MongoDB — set MONGODB_URI, or the parts below
# MONGODB_URI=mongodb+srv://user:pass@cluster/db
MONGODB_USER=your_username
MONGODB_PASSWORD=your_password
MONGODB_CLUSTER=your_cluster    #mongodb+srv://your_username:your_password@your_cluster/your_database
MONGODB_DB=your_database

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Shared with QuantumAI backend (≥32 chars) for /messages/quantum-ai-response receipts
QUANTUM_AI_SERVICE_SECRET=your_quantum_ai_service_secret

CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Blob storage
# ---------------------------------------------------------------------------
# Production / Vercel: set Google Drive credentials (Shared Drive folder shared
# with the service account as Content manager). PRIVATE_KEY: keep \n escapes.
# Local development: if these are unset, files are stored under backend/uploads/.
# Or force local disk with STORAGE_PROVIDER=local
# GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your_google_service_account_email
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# STORAGE_PROVIDER=local
