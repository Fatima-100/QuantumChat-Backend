NODE_ENV=development
PORT=5000

# MongoDB — set MONGODB_URI, or the parts below
# MONGODB_URI=mongodb+srv://user:pass@cluster/db
MONGODB_USER=your_username
MONGODB_PASSWORD=your_password
MONGODB_CLUSTER=your_cluster    #mongodb+srv://your_username:your_password@your_cluster/your_database
MONGODB_DB=your_database

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
JWT_REMEMBER_EXPIRES_IN=90d

# Shared with QuantumAI backend (≥32 chars) for /messages/quantum-ai-response receipts
QUANTUM_AI_SERVICE_SECRET=your_quantum_ai_service_secret

CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Web Push (browser / Windows toast notifications when you’re in another app)
# Required for reliable pop-ups on Vercel — without these, keys may rotate and
# subscriptions stop working. Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@yourdomain.com
# If unset, keys are stored in MongoDB (app_config) and optionally
# backend/data/vapid-keys.json for local dev.

# ---------------------------------------------------------------------------
# Blob storage — REQUIRED IN PRODUCTION (Vercel's filesystem is ephemeral,
# so local disk does not persist uploads there)
# ---------------------------------------------------------------------------
# Get these from your Cloudinary dashboard: https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Local development only: if the Cloudinary vars above are unset, files are
# stored under backend/uploads/ instead. Not valid in production.
# STORAGE_PROVIDER=local
# ---------------------------------------------------------------------------
# Web Push (VAPID) — required so browser push subscriptions stay valid across
# server restarts. Generate ONCE with: npx web-push generate-vapid-keys
# then paste the output here and never regenerate for an existing deployment
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:you@example.com
