NODE_ENV=development
PORT=5000

# MongoDB — set MONGODB_URI, or the parts below
# MONGODB_URI=mongodb+srv://user:pass@cluster/db
MONGODB_USER=your_username
MONGODB_PASSWORD=your_password
MONGODB_CLUSTER=your_cluster    #mongodb+srv://your_username:your_password@your_cluster/your_database
MONGODB_DB=your_database

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
JWT_REMEMBER_EXPIRES_IN=90d

# Shared with QuantumAI backend (≥32 chars) for /messages/quantum-ai-response receipts
QUANTUM_AI_SERVICE_SECRET=your_quantum_ai_service_secret

CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Blob storage — REQUIRED IN PRODUCTION (Vercel's filesystem is ephemeral,
# so local disk does not persist uploads there)
# ---------------------------------------------------------------------------
# Get these from your Cloudinary dashboard: https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Local development only: if the Cloudinary vars above are unset, files are
# stored under backend/uploads/ instead. Not valid in production.
# STORAGE_PROVIDER=local
